# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_BASE_URL=https://kifuki.com

# Admin auth (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Data provider: sqlite | supabase
DATABASE_PROVIDER=sqlite
SQLITE_PATH=./data/kifuki.db

# Supabase (only when DATABASE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shopier. Keep the access token server-side only.
SHOPIER_API_ENABLED=false
SHOPIER_ACCESS_TOKEN=
SHOPIER_PRODUCTS_URL=
SHOPIER_STORE_URL=https://www.shopier.com/kifuki
